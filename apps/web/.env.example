# Public, build-time values only: every VITE_* value is inlined into the bundle.
# Unknown VITE_* keys fail the build (see src/shared/config/env.schema.ts).

# API origin used by @repo/api-client (https required in production builds)
VITE_API_URL=http://localhost:3000

# Optional: Sentry DSN; leave empty to disable error reporting
VITE_SENTRY_DSN=

# Development only: answer API calls from the in-browser mock (src/app/mocks)
# instead of VITE_API_URL. Production builds ignore it.
VITE_API_MOCK=false
