{
  "name": "@repo/root",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run format:check && turbo run lint typecheck test build",
    "prepare": "lefthook install",
    "knip": "knip"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": []
}
