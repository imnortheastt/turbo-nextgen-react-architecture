{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit", "i18n:compile"]
    },
    "typecheck": {
      "dependsOn": ["transit", "i18n:compile"]
    },
    "test": {
      "dependsOn": ["transit", "i18n:compile"],
      "outputs": ["coverage/**"]
    },
    "build": {
      "dependsOn": ["transit", "i18n:compile"],
      "env": ["VITE_*"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["i18n:compile"]
    },
    "i18n:compile": {
      "inputs": ["project.inlang/**", "messages/**"],
      "outputs": ["src/shared/i18n/paraglide/**"]
    },
    "api:gen": {
      "cache": false,
      "inputs": ["api/**", "orval.config.ts"]
    }
  }
}
